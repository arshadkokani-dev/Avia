// Generate the Prisma client used by the API.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum GoalType {
  MILESTONE
  RECURRING
}

enum GoalFrequency {
  DAILY
  WEEKLY
}

enum TrackingMode {
  QUANTITY
  COMPLETION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  goals Goal[]
}

model Goal {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)

  // Information used by the Goals & Tracking interface.
  area         String          @default("Learning")
  type         GoalType        @default(MILESTONE)
  frequency    GoalFrequency?
  targetDate   DateTime?
  progress     Int             @default(0)
  trackingMode TrackingMode?
  dailyTarget  Float?
  unit         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackingRecords GoalTracking[]
}

model GoalTracking {
  id          String   @id @default(uuid())
  periodStart DateTime
  amount      Float    @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // One record per goal per tracking period.
  @@unique([goalId, periodStart])
  @@index([goalId, periodStart])
}