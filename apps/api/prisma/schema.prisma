// Generate the Prisma client used by the API.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum GoalType {
  MILESTONE
  RECURRING
}

enum GoalFrequency {
  DAILY
  WEEKLY
}

enum TrackingMode {
  QUANTITY
  COMPLETION
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

enum HabitStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  FREE
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  goals  Goal[]
  habits Habit[]
  weeklyPlans WeeklyPlan[]
  libraryResources LibraryResource[]
  journalEntries JournalEntry[]
  aiConversations AIConversation[]
  subscription Subscription?
}

model Goal {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  progressHistory GoalProgressHistory[]

  // Information used by the Goals and Tracking interface.
  area         String          @default("Learning")
  type         GoalType        @default(MILESTONE)
  frequency    GoalFrequency?
  targetDate   DateTime?
  progress     Int             @default(0)
  trackingMode TrackingMode?
  dailyTarget  Float?
  unit         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackingRecords  GoalTracking[]

}

model GoalTracking {
  id          String   @id @default(uuid())
  periodStart DateTime
  amount      Float    @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // One record per goal per tracking period.
  @@unique([goalId, periodStart])
  @@index([goalId, periodStart])
}

model GoalProgressHistory {
  id        String   @id @default(uuid())
  progress  Int
  createdAt DateTime @default(now())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

model Habit {
  id           String         @id @default(uuid())
  name         String
  description  String?
  area         String         @default("Habits")
  skill        String?
  frequency    HabitFrequency @default(DAILY)
  weeklyTarget Int?
  status       HabitStatus    @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries HabitEntry[]

  @@index([userId, status])
}

model HabitEntry {
  id        String   @id @default(uuid())
  entryDate DateTime
  completed Boolean  @default(false)
  amount    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  // Prevent duplicate entries for a habit on the same date.
  @@unique([habitId, entryDate])
  @@index([habitId, entryDate])
}

model WeeklyPlan {
  id        String   @id @default(uuid())
  weekStart DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks PlannedTask[]

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model PlannedTask {
  id            String   @id @default(uuid())
  title         String
  scheduledDate DateTime @db.Date
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  weeklyPlanId String
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@index([weeklyPlanId, scheduledDate])
}

model LibraryResource {
  id          String   @id @default(uuid())
  title       String
  url         String
  category    String   @default("General")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model JournalEntry {
  id        String   @id @default(uuid())
  title     String   @default("My journal entry")
  content   String   @db.Text
  mood      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AIConversation {
  id        String        @id @default(uuid())
  title     String        @default("New conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  AIChatMessage[]

  @@index([userId, updatedAt])
}

model AIChatMessage {
  id             String         @id @default(uuid())
  role           String
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Subscription {
  id String @id @default(uuid())

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(FREE)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  razorpaySubscriptionId String? @unique
  razorpayPlanId         String?
  billingInterval        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan, status])
}